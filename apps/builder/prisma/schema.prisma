generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  accounts  Account[]
  sessions  Session[]
  workspaces WorkspaceMember[]
  records   Record[]
  votes     Vote[]
  comments  Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspace & App ─────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members WorkspaceMember[]
  apps    App[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model App {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  branding    Json     @default("{}")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  modules   AppModule[]
  pages     Page[]

  @@unique([workspaceId, slug])
}

// ─── Module & Collection ──────────────────────────────────────────────────────

model AppModule {
  id        String   @id @default(cuid())
  appId     String
  moduleKey String
  label     String
  icon      String   @default("Box")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  app         App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  collections Collection[]
}

model Collection {
  id       String @id @default(cuid())
  moduleId String
  name     String
  slug     String

  module  AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  fields  Field[]
  views   View[]
  records Record[]

  @@unique([moduleId, slug])
}

model Field {
  id           String    @id @default(cuid())
  collectionId String
  name         String
  slug         String
  type         FieldType
  required     Boolean   @default(false)
  config       Json      @default("{}")
  order        Int       @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, slug])
}

enum FieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  FILE
  RELATION
}

model Record {
  id           String   @id @default(cuid())
  collectionId String
  createdById  String?
  values       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  votes      Vote[]
  comments   Comment[]
}

// ─── Views ────────────────────────────────────────────────────────────────────

model View {
  id           String   @id @default(cuid())
  collectionId String
  name         String
  type         ViewType
  config       Json     @default("{}")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  blocks Block[]
}

enum ViewType {
  LIST
  KANBAN
  TABLE
  FORM
  GALLERY
  CALENDAR
}

// ─── Pages & Blocks ──────────────────────────────────────────────────────────

model Page {
  id        String   @id @default(cuid())
  appId     String
  name      String
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  app    App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  blocks Block[]

  @@unique([appId, slug])
}

model Block {
  id     String    @id @default(cuid())
  pageId String
  type   BlockType
  order  Int       @default(0)
  config Json      @default("{}")

  viewId String?
  view   View?   @relation(fields: [viewId], references: [id], onDelete: SetNull)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

enum BlockType {
  VIEW_EMBED
  RICH_TEXT
  HEADING
  DIVIDER
  METRIC
}

// ─── Social ───────────────────────────────────────────────────────────────────

model Vote {
  id       String @id @default(cuid())
  recordId String
  userId   String

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  recordId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
