{
  "$schema": "https://schemas.designtokens.org/2025-10/format.json",
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Duration ladder. Always wrap in @media (prefers-reduced-motion: no-preference).",
      "instant":  { "$value": { "value": 0,   "unit": "ms" } },
      "fast":     { "$value": { "value": 100, "unit": "ms" } },
      "quick":    { "$value": { "value": 150, "unit": "ms" } },
      "moderate": { "$value": { "value": 200, "unit": "ms" } },
      "smooth":   { "$value": { "value": 300, "unit": "ms" } },
      "slow":     { "$value": { "value": 500, "unit": "ms" } },
      "slower":   { "$value": { "value": 700, "unit": "ms" } },
      "slowest":  { "$value": { "value": 1000,"unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Semantic easing curves. Use 'standard' for most UI, 'enter'/'exit' for component lifecycle.",
      "linear":   { "$value": [0, 0, 1, 1] },
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "enter":    { "$value": [0, 0, 0.2, 1] },
      "exit":     { "$value": [0.4, 0, 1, 1] },
      "sharp":    { "$value": [0.4, 0, 0.6, 1] },
      "bounce":   { "$value": [0.34, 1.56, 0.64, 1] },
      "smooth":   { "$value": [0.45, 0, 0.55, 1] }
    }
  }
}
