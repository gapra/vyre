{
  "$schema": "https://schemas.designtokens.org/2025-10/format.json",
  "color": {
    "scales": {
      "amber": {
        "$description": "Amber semantic scale. 1–2: backgrounds; 3–5: component states; 6–8: borders; 9–10: solid; 11–12: text. Use for warning and attention states. Note: step 9 is intentionally light — pair with step 12 for text on solid.",
        "1":  { "$type": "color", "$value": "{color.primitive.amber.1}",  "$description": "App background" },
        "2":  { "$type": "color", "$value": "{color.primitive.amber.2}",  "$description": "Subtle background" },
        "3":  { "$type": "color", "$value": "{color.primitive.amber.3}",  "$description": "UI element background" },
        "4":  { "$type": "color", "$value": "{color.primitive.amber.4}",  "$description": "Hovered UI element background" },
        "5":  { "$type": "color", "$value": "{color.primitive.amber.5}",  "$description": "Active / selected UI element background" },
        "6":  { "$type": "color", "$value": "{color.primitive.amber.6}",  "$description": "Subtle border and separator" },
        "7":  { "$type": "color", "$value": "{color.primitive.amber.7}",  "$description": "UI element border and focus ring" },
        "8":  { "$type": "color", "$value": "{color.primitive.amber.8}",  "$description": "Hovered UI element border" },
        "9":  { "$type": "color", "$value": "{color.primitive.amber.9}",  "$description": "Solid background — peak saturation; use step 12 for foreground text" },
        "10": { "$type": "color", "$value": "{color.primitive.amber.10}", "$description": "Hovered solid background" },
        "11": { "$type": "color", "$value": "{color.primitive.amber.11}", "$description": "Low-contrast text" },
        "12": { "$type": "color", "$value": "{color.primitive.amber.12}", "$description": "High-contrast text — only safe foreground on amber solid" },
        "a1":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.02 }, "$description": "Alpha: app background" },
        "a2":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.04 }, "$description": "Alpha: subtle background" },
        "a3":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.08 }, "$description": "Alpha: UI element background" },
        "a4":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.14 }, "$description": "Alpha: hovered UI element background" },
        "a5":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.22 }, "$description": "Alpha: active UI element background" },
        "a6":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.33 }, "$description": "Alpha: subtle border" },
        "a7":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.48 }, "$description": "Alpha: UI element border" },
        "a8":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.64 }, "$description": "Alpha: hovered border" },
        "a9":  { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.76 }, "$description": "Alpha: solid" },
        "a10": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.83 }, "$description": "Alpha: hovered solid" },
        "a11": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.90 }, "$description": "Alpha: low-contrast text" },
        "a12": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.180, 75], "alpha": 0.95 }, "$description": "Alpha: high-contrast text" }
      }
    }
  }
}
